{
  "name": "ebac-store-ios-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Automação E2E iOS da EBAC Store (WebdriverIO + Appium + Sauce Labs)",
  "scripts": {
    "test": "wdio run config/wdio.conf.js",
    "test:login": "wdio run config/wdio.conf.js --spec testes/test_login.js",
    "test:checkout": "wdio run config/wdio.conf.js --spec testes/test_checkout.js",
    "report": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "app:download": "../app/scripts/download-app.sh",
    "app:upload": "../app/scripts/upload-sauce.sh"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@wdio/allure-reporter": "^10.2.0",
    "@wdio/cli": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/sauce-service": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "allure-commandline": "^2.46.1",
    "dotenv": "^18.0.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "edgedriver": false,
    "geckodriver": false
  }
}
